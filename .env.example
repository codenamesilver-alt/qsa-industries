# Database toolchain environment.
#
# Copy this file to .env in the repository root and fill in the values. The
# scripts in scripts/ read it automatically, so `npm run db:test` works with no
# export step. Real environment variables always take precedence over this file.
#
# .env is gitignored.

# Supabase: Settings -> Database -> Connection string (Session pooler).
# Use the session pooler, not the transaction pooler: db-verify-fresh.mjs opens
# a connection and then switches to another database on the same server, which
# the transaction pooler does not allow.
PGHOST=aws-0-ap-northeast-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=your-database-password

# Set to "disable" when pointing at a local PostgreSQL that has no TLS.
# PGSSLMODE=disable
