select viewname, definition from pg_views where schemaname=' => [{"viewname":"org_chart","definition":" SELECT p.id,\n    p.title,\n    p.parent_id,\n    p.sort_order,\n    p.user_id,\n    person.full_name AS user_full_name,\n    person.email AS user_email,\n    person.role AS user_role,\n    person.designation AS user_designation,\n    person.designation_id AS user_designation_id,\n    person.is_active AS user_is_active\n   FROM (org_positions p\n     LEFT JOIN LATERAL private.org_person(p.user_id) person(full_name, email, role, designation, designation_id, is_active) ON (true));"},{"viewname":"org_people","definition":" SELECT user_id,\n    full_name,\n    email,\n    role,\n    designation_id,\n    designation,\n    is_active,\n    reports_to_id,\n    sort_order\n   FROM private.org_people_rows() p(user_id, full_name, email, role, designation, designation_id, is_active, reports_to_id, sort_order);"},{"viewname":"org_people_tree","definition":" SELECT p.user_id,\n    p.full_name,\n    p.email,\n    p.role,\n    p.designation_id,\n    p.designation,\n    p.is_active,\n    p.reports_to_id,\n    mgr.full_name AS reports_to_name,\n    mgr.designation_id AS reports_to_designation_id,\n    mgr.designation AS reports_to_designation,\n    p.sort_order\n   FROM (private.org_people_rows() p(user_id, full_name, email, role, designation, designation_id, is_active, reports_to_id, sort_order)\n     LEFT JOIN private.org_people_rows() mgr(user_id, full_name, email, role, designation, designation_id, is_active, reports_to_id, sort_order) ON ((mgr.user_id = p.reports_to_id)));"},{"viewname":"org_staff_roster","definition":" SELECT user_id,\n    full_name,\n    email,\n    role,\n    designation,\n    designation_id,\n    is_active\n   FROM private.org_staff_roster() r(user_id, full_name, email, role, designation, designation_id, is_active);"}]
