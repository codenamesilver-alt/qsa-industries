select 'role' as k, string_agg(e.enumlabel, ' | ' order by e => [{"k":"role","v":"admin | production_manager | inventory_manager | sales_rep | sales_manager | sales_director | logistics | finance | dealer | qc_staff"},{"k":"order_status","v":"pending | approved | pending_director_approval | dispatched | invoiced | rejected"},{"k":"delivery_status","v":"awaiting_dispatch | in_transit | delivered"},{"k":"stock_movement_type","v":"in | out"},{"k":"stock_movement_source","v":"production | sales | adjustment | opening_balance | purchase"},{"k":"production_qc_status","v":"pending | passed | failed"},{"k":"purchase_order_status","v":"draft | ordered | partially_received | received | cancelled"},{"k":"dealer_status","v":"active | inactive | suspended"},{"k":"payment_mode","v":"cash | bank_transfer | upi | cheque | other | card"},{"k":"designations","v":"CFO | CEO | Plant Manager | Director | Production Manager | Partner | Quality Manager | Quality Inspector | QC Chemist | Store Keeper | Inventory Manager | Purchase Manager | Logistics Manager | Accounts Executive | Accounts Manager | Finance Manager | Sales Director | Sales Manager | Senior Sales Executive | Sales Executive | Customer Care Executive"}]
